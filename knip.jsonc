{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Prettier loads the plugins named in `@repo/prettier` by package name,
      // resolved from the directory it runs in -- the root, for `pnpm format`.
      // Knip cannot see that indirection, but removing these breaks formatting
      // on a clean checkout.
      "ignoreDependencies": [
        "@ianvs/prettier-plugin-sort-imports",
        "prettier-plugin-tailwindcss",
      ],
    },
    "apps/extension": {
      // Knip's Vite plugin only discovers `index.html`; the extension's
      // entries are the two pages, the service worker and the injected
      // extractor (all wired up in vite.config.ts).
      "entry": [
        "src/sidepanel/main.tsx",
        "src/library/main.tsx",
        "src/background/service-worker.ts",
        "src/content/extractor.ts",
      ],
    },
  },
}
